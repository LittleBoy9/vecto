{
  "name": "vecto",
  "description": "AI-powered SVG generation and editing desktop app built with Tauri, React, and TypeScript.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "keywords": [
    "svg",
    "editor",
    "ai",
    "tauri",
    "design-tool",
    "claude"
  ],
  "author": "Sounak Das",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
